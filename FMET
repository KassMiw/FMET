L#!/bin/bash

# Variable
FMET_DIR=/sdcard/FMET
output=$FMET_DIR/output
mkdir -p $output

# Debugging
if [ "$2" = "D" ] || [ "$2" = "d" ] || [ "$2" = "Debug" ] || [ "$2" = "DEBUG" ] || [ "$2" = "debug" ]; then
  CMD=ffmpeg
elif [ "$2" = "!" ]; then
  CMD=ffpb
else
  CMD=ffpb
fi

# Function
BANNER() {
echo -e "\e[1;34m"
cat << EOF
███████╗███╗   ███╗███████╗████████╗
██╔════╝████╗ ████║██╔════╝╚══██╔══╝
█████╗  ██╔████╔██║█████╗     ██║   
██╔══╝  ██║╚██╔╝██║██╔══╝     ██║   
██║     ██║ ╚═╝ ██║███████╗   ██║   
╚═╝     ╚═╝     ╚═╝╚══════╝   ╚═╝   
EOF
echo -e "\e[0;0m"
}

# AV1
FMET_AV1() {
# Extension 
echo -e "───────────────────────────────────────────────"
echo -e "\e[1;34mInput video extension"
echo -e "\e[1;32mmp4, mkv, avi, webm\e[0;0m"
echo -e "───────────────────────────────────────────────"
read ext
echo -e "───────────────────────────────────────────────"

# Bitrate
echo -e "───────────────────────────────────────────────"
echo -e "\e[1;34mInput video bitrate"
echo -e "\e[1;32mauto, 100K, 1000K, 1M, 10M\e[0;0m"
echo -e "───────────────────────────────────────────────"
read bitrate
echo -e "───────────────────────────────────────────────"

# Start 
for file in $FMET_DIR/*.$ext; do
# Output file
 f=$(basename "$file")
  out_file="$output/$f"
# Bitrate 
 if [ $bitrate = auto ]; then
   $CMD -hide_banner -i "$file" -c:v av1_mediacodec -c:a copy "$out_file"
  else
   $CMD -hide_banner -i "$file" -c:v av1_mediacodec -b:v $bitrate -c:a copy "$out_file"
 fi
done

# Scan media
termux-media-scan -r $output 1> /dev/null
}

